<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/notePageBackground"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_padding"
    android:paddingRight="@dimen/screen_padding">

    <EditText
        android:id="@+id/note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:hint="@string/title_hint"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="52dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/noteTextPrimary"
        android:textColorHint="?attr/noteTextHint"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/noteDividerColor" />

    <EditText
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:fadingEdge="vertical"
        android:gravity="top"
        android:hint="@string/note_hint"
        android:inputType="textMultiLine"
        android:lineSpacingMultiplier="1.6"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical"
        android:textColor="?attr/noteTextBody"
        android:textColorHint="?attr/noteTextHint"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/editor_status"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/noteCardBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editor_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/noteTextBody"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/editor_status_undo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/action_undo"
            android:textColor="?attr/noteBrandColor"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
